# Copy to .env and edit. Never commit .env.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./inspection.db
STORAGE_DIR=./storage
MODELS_DIR=../models
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15
BATCH_WORKERS=2
BATCH_QUEUE_SIZE=500
# Used ONLY by `python -m app.scripts.seed` (development only)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Admin-123
